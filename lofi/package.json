{
  "name": "hackday-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/postbuild.mjs",
    "preview": "vite preview",
