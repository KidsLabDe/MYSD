{
  "name": "mys-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Live agenda board for Make Your School (MYS) Hackdays, KidsLab branding",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
